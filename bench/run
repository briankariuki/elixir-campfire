#!/usr/bin/env python3
"""Benchmark the production image on the Rails Campfire workloads, methodology of
basecamp/once-campfire-elixir bench/run (MIT).

  bench/run [--apps campfire[=IMAGE][,NAME=IMAGE...]] [--reps 4] [--out DIR] [--user-agent UA]
            [--dry-run] [--rebuild]
  bench/report DIR [--with-upstream [PATH]]
  bench/compare A B

Per rep, for each app in turn (never two at once; the order alternates between reps): fresh Postgres
container + fresh app container from the production image, BOTH pinned to SERVER_CPUS; bin/migrate, the
seed SQL (bench/seed/default/campfire.sql) and the seed uploads are loaded; then cold start, idle memory,
the HTTP suite, the LiveView fan-out suite, the optional distinct-users fan-out and the upload suite, with
container memory sampled throughout and each process's memory, by role, during the fan-outs. The load
generator (bench/loadgen) runs in a container pinned to LOADGEN_CPUS. Before each run it waits (up to
LOAD_WAIT_SECS) for the 1-minute load average to drop below LOAD_MAX.

On macOS this script re-executes itself inside a privileged harness container on OrbStack's Linux engine
(bench/lib/harness.Dockerfile) so that taskset, /proc/loadavg and the containers' cgroups are available.
See bench/README.md.

Knobs (environment; defaults in bench/lib/benchlib.py): SERVER_CPUS=0-3 LOADGEN_CPUS=4-7 PROCMEM_CPUS=8-9
HTTP_SECS=8 HTTP_CONCS="1 16 64" CABLE_CLIENTS="100 500 1000" CABLE_TPUT_SECS=15 CABLE_POSTERS=4
UPLOAD_REPS=5 DISTINCT_CLIENTS="100 500 1000" PORT=47130 (Postgres on PORT+1) LOAD_MAX=1.5
LOAD_WAIT_SECS=900 SUITES="http liveview upload" (add "distinct") APP_IMAGE=campfire-port:bench
PG_IMAGE=postgres:17 PG_ARGS="" LOADGEN_IMAGE=campfire-loadgen:bench APP_EXTRA_ENV="" SEED_DIR=bench/seed/default
LIVEVIEW_ARGS="" (extra loadgen flags for the fan-out suites, e.g. "--deflate 1")
"""
import argparse, json, os, platform, shutil, subprocess, sys, time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import benchlib as B  # noqa: E402

HARNESS_IMAGE = "campfire-bench-harness:latest"
# Environment variables forwarded into the harness container.
FORWARD = ["SERVER_CPUS", "LOADGEN_CPUS", "PROCMEM_CPUS", "HTTP_SECS", "HTTP_CONCS", "CABLE_CLIENTS", "CABLE_TPUT_SECS",
           "CABLE_POSTERS", "DISTINCT_CLIENTS", "UPLOAD_REPS", "PORT", "PG_PORT", "LOAD_MAX", "LOAD_WAIT_SECS", "IDLE_SECS", "SUITES",
           "APP_IMAGE", "PG_IMAGE", "PG_ARGS", "LOADGEN_IMAGE", "LOADGEN_ENTRYPOINT", "APP_EXTRA_ENV", "SECRET_KEY_BASE",
           "BASE_HOST", "SEED_DIR", "LIVEVIEW_ARGS", "BENCH_KEEP"]


def sh_out(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True, shell=isinstance(cmd, str))
    return p.stdout.strip()


# --- macOS launcher -----------------------------------------------------------------------------------

def host_info():
    lines = [
        f"{sh_out('sysctl -n machdep.cpu.brand_string')}, {sh_out('sysctl -n hw.ncpu')} cores "
        f"({sh_out('sysctl -n hw.perflevel0.logicalcpu')} performance + {sh_out('sysctl -n hw.perflevel1.logicalcpu')} efficiency), "
        f"{int(sh_out('sysctl -n hw.memsize') or 0) // 2**30}GB, macOS {sh_out('sw_vers -productVersion')}",
        f"orbstack: {sh_out('orb version | head -1')}; VM cpu/memory: {sh_out('orb config show | grep -E \"^(cpu|memory_mib):\" | tr \"\\n\" \" \"')}",
        f"power: {sh_out('pmset -g batt | head -2 | tr \"\\n\" \" \"')}; lowpowermode={sh_out('pmset -g | grep -i lowpowermode | xargs')}",
        f"host load before: {sh_out('uptime')}",
    ]
    return "\n".join(lines)


def source_digest_from_host():
    try:
        g = lambda *a: subprocess.run(["git", "-C", B.ROOT, *a], capture_output=True, text=True, check=True).stdout
        rev = g("rev-parse", "HEAD").strip()
        status = g("status", "--porcelain", "--", *B.SOURCE_PATHS).splitlines()
        import hashlib
        diff = hashlib.sha256(g("diff", "HEAD", "--", *B.SOURCE_PATHS).encode()).hexdigest()[:12] if status else ""
        return f"{rev} (dirty: {len(status)} files{', diff sha256 ' + diff if status else ''})"
    except Exception as e:  # noqa: BLE001
        return f"unknown ({e})"


def launch_in_harness(argv, rebuild, script="run"):
    if subprocess.run(["docker", "info"], capture_output=True).returncode != 0:
        sys.exit("docker is not reachable. Start OrbStack (`orb start`) and retry.")
    if rebuild or subprocess.run(["docker", "image", "inspect", HARNESS_IMAGE], capture_output=True).returncode != 0:
        B.log("building the harness image")
        subprocess.run(["docker", "build", "-q", "-t", HARNESS_IMAGE, "-f", os.path.join(B.BENCH, "lib", "harness.Dockerfile"),
                        os.path.join(B.BENCH, "lib")], check=True)
    name = f"bench-harness-{B.PORT}"
    subprocess.run(["docker", "rm", "-f", name], capture_output=True)
    cmd = ["docker", "run", "--rm", "--init", "--name", name, "--privileged", "--pid", "host", "--cgroupns", "host", "--network", "host",
           "--cpuset-cpus", B.PROCMEM_CPUS, "-v", "/var/run/docker.sock:/var/run/docker.sock", "-v", "/sys/fs/cgroup:/sys/fs/cgroup",
           "-v", f"{B.ROOT}:{B.ROOT}", "-w", B.ROOT, "-e", "BENCH_IN_HARNESS=1",
           "-e", f"BENCH_HOST_INFO={host_info()}", "-e", f"BENCH_SOURCE_DIGEST={source_digest_from_host()}",
           "-e", f"BENCH_OUT_HOST_USER={os.getuid()}:{os.getgid()}"]
    for k in FORWARD + [k for k in os.environ if k.startswith("APP_EXTRA_ENV_")]:
        if k in os.environ:
            cmd += ["-e", f"{k}={os.environ[k]}"]
    cmd += [HARNESS_IMAGE, "python3", os.path.join(B.BENCH, script), *argv]
    if shutil.which("caffeinate"):   # keep the Mac awake for the whole run
        cmd = ["caffeinate", "-i", *cmd]
    try:
        rc = subprocess.call(cmd)
    except KeyboardInterrupt:
        # Let the harness clean up its containers (it handles SIGINT), then make sure it is gone.
        subprocess.run(["docker", "kill", "--signal", "INT", name], capture_output=True)
        for _ in range(60):
            if subprocess.run(["docker", "inspect", name], capture_output=True).returncode != 0:
                break
            time.sleep(1)
        subprocess.run(["docker", "kill", name], capture_output=True)
        rc = 130
    sys.exit(rc)


# --- Environment record ------------------------------------------------------------------------------

def write_env(path, apps, reps, user_agent):
    cpu_model = ""
    try:
        cpu_model = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "")
    except OSError:
        pass
    mem_gb = round(int(next(l.split()[1] for l in open("/proc/meminfo") if l.startswith("MemTotal"))) / 1048576, 1)
    server_n = B.cpu_count(B.SERVER_CPUS)
    lines = [
        f"date: {time.strftime('%Y-%m-%dT%H:%M:%S%z')}",
        f"host: {os.environ.get('BENCH_HOST_INFO', platform.node()).splitlines()[0]}",
        *[f"host ({i}): {l}" for i, l in enumerate(os.environ.get("BENCH_HOST_INFO", "").splitlines()[1:], 1)],
        f"linux (where the benchmark runs): {platform.release()} {platform.machine()}, {cpu_model or 'cpu model not exposed'}, {os.cpu_count()} vCPUs, {mem_gb}GB"
        f"{' (OrbStack VM, harness container)' if os.environ.get('BENCH_IN_HARNESS') else ''}",
        f"server cpus: {B.SERVER_CPUS} (nproc {server_n}; Postgres + app together); loadgen cpus: {B.LOADGEN_CPUS}; harness cpus: {B.PROCMEM_CPUS}; network: host",
        f"env (app): PORT={B.PORT} PHX_HOST=localhost MIX_ENV=prod (image) TRUST_PROXY_HEADERS=(unset) POOL_SIZE=(default 10) UPLOADS_DIR=/data/uploads "
        f"APP_EXTRA_ENV={' '.join(B.APP_EXTRA_ENV) or '(none)'} LIVEVIEW_ARGS={' '.join(B.LIVEVIEW_ARGS) or '(none)'}",
        f"postgres: {B.PG_IMAGE} port {B.PG_PORT} args: {' '.join(B.PG_ARGS) or '(defaults)'}",
        *[f"seed sha256: {l}" for l in B.seed_digest()],
        f"source digest: {B.source_digest()}",
        f"workload: suites={' '.join(B.SUITES)} HTTP_SECS={B.HTTP_SECS} HTTP_CONCS={' '.join(B.HTTP_CONCS)} CABLE_CLIENTS={' '.join(B.CABLE_CLIENTS)} "
        f"CABLE_TPUT_SECS={B.CABLE_TPUT_SECS} CABLE_POSTERS={B.CABLE_POSTERS} DISTINCT_CLIENTS={' '.join(B.DISTINCT_CLIENTS)} "
        f"UPLOAD_REPS={B.UPLOAD_REPS} IDLE_SECS={B.IDLE_SECS} REPS={reps}",
        f"quiet wait: LOAD_MAX={B.LOAD_MAX} LOAD_WAIT_SECS={B.LOAD_WAIT_SECS}",
        f"user agent: {user_agent or '(none)'}",
        *[f"{n} image: {img} {B.image_id(img)}" for n, img in apps],
        f"postgres image id: {B.image_id(B.PG_IMAGE)}",
        f"loadgen image: {B.LOADGEN_IMAGE} {B.image_id(B.LOADGEN_IMAGE)}",
    ]
    open(path, "w").write("\n".join(lines) + "\n")
    return "\n".join(lines)


# --- One rep -------------------------------------------------------------------------------------------

def dump(path, obj):
    json.dump(obj, open(path, "w"), indent=1)


def docker_rm_app():
    B.docker("rm", "-f", B.APP_NAME)


def run_rep(name, image, rep, out, labels, ua):
    import suites as S
    log = lambda m: B.log(f"{name} rep {rep}: {m}")
    f = os.path.join(out, f"{name}-{rep}")
    B.wait_for_quiet()
    load_start = " ".join(B.loadavg())
    B.cleanup()
    shutil.rmtree(B.WORK, ignore_errors=True)
    os.makedirs(B.WORK)
    sampler = None
    try:
        log(f"starting (load: {load_start})")
        B.start_postgres()
        migrate_ms = B.migrate(image, name)
        B.load_data()
        B.seed_tweaks(labels)
        cold_ms = B.start_app(image, name)
        cgs = {"app": B.cgroup_dir(B.APP_NAME), "db": B.cgroup_dir(B.PG_NAME)}
        pinning = {n: B.docker("inspect", "-f", "{{.HostConfig.CpusetCpus}}", c).stdout.strip() for n, c in (("app", B.APP_NAME), ("db", B.PG_NAME))}
        assert set(pinning.values()) == {B.SERVER_CPUS}, f"containers are not pinned to {B.SERVER_CPUS}: {pinning}"
        time.sleep(B.IDLE_SECS)
        cur, anon = B.memory_now(cgs)
        idle = {"idle_current_mb": sum(cur.values()) // B.MB, "idle_anon_mb": sum(anon.values()) // B.MB,
                **{f"{k}_idle_current_mb": v // B.MB for k, v in cur.items()}, **{f"{k}_idle_anon_mb": v // B.MB for k, v in anon.items()}}
        sampler = B.Sampler(cgs)
        sampler.start()
        log(f"cold start {cold_ms}ms (bin/migrate {migrate_ms}ms), idle {idle['idle_current_mb']}MB (anon {idle['idle_anon_mb']}MB; app {idle['app_idle_current_mb']}, db {idle['db_idle_current_mb']})")

        cookie = S.login(labels["email"], labels["password"])
        css = S.scrape_css(cookie, labels["busy_room"])
        rs = S.routes(labels, css)
        S.preflight(labels, cookie, rs, f + "-validation.json")
        if os.environ.get("BENCH_PREPARE_ONLY") == "1":
            log("prepare-only: database, app, login and preflight all passed; stopping before the suites")
            return
        suites = {"http": [], "liveview": [], "distinct": [], "upload": {}}
        if "http" in B.SUITES:
            suites["http"] = S.http_suite(cookie, labels, rs, cgs, log)
            dump(f + "-http.json", suites["http"])
        if "liveview" in B.SUITES:
            suites["liveview"] = S.fanout_suite("liveview", B.CABLE_CLIENTS, cookie, labels, cgs, log)
            dump(f + "-liveview.json", suites["liveview"])
        if "upload" in B.SUITES:
            suites["upload"] = S.upload_suite(labels, cookie, log)
            dump(f + "-upload.json", suites["upload"])

        time.sleep(0.5)
        sampler.stop()
        mem = {**idle, **sampler.result(), "cgroup_peak_mb": sum(B.read_int(f"{c}/memory.peak") for c in cgs.values()) // B.MB}
        dump(f + "-jobs.json", S.job_state())
        if "distinct" in B.SUITES:
            # Last, on a restarted app: sign-in is limited to 10 per 3 minutes per IP, so each user signs in with its own
            # X-Forwarded-For, which the app honours only with TRUST_PROXY_HEADERS=1. Memory above is not affected.
            log("distinct-users fan-out: restarting the app with TRUST_PROXY_HEADERS=1 (data kept)")
            docker_rm_app()
            B.start_app(image, name, extra_env=["TRUST_PROXY_HEADERS=1"])
            cgs = {"app": B.cgroup_dir(B.APP_NAME), "db": B.cgroup_dir(B.PG_NAME)}
            users_file = S.prepare_distinct_users(max(map(int, B.DISTINCT_CLIENTS)), labels)
            suites["distinct"] = S.fanout_suite("distinct", B.DISTINCT_CLIENTS, cookie, labels, cgs, log, users_file)
            dump(f + "-distinct.json", suites["distinct"])
        dump(f"{f}.json", {
            "app": name, "rep": rep, "cold_start_ms": cold_ms, "migrate_ms": migrate_ms, "pinning": {**pinning, "loadgen": B.LOADGEN_CPUS}, "memory": mem,
            "http": suites["http"], "liveview": suites["liveview"], "distinct": suites["distinct"], "upload": suites["upload"],
            "skipped_workloads": S.SKIPPED, "loadavg_start": load_start, "loadavg_end": " ".join(B.loadavg()),
        })
        log(f"done -> {f}.json")
    finally:
        if sampler and sampler.is_alive():
            sampler.running = False
        if os.environ.get("BENCH_KEEP") != "1":
            B.cleanup()
            shutil.rmtree(B.WORK, ignore_errors=True)
        user = os.environ.get("BENCH_OUT_HOST_USER")
        if user and os.path.isdir(out):   # results written by the harness (root) belong to the invoking user
            subprocess.run(["chown", "-R", user, out], capture_output=True)


def parse_apps(spec):
    apps = []
    for part in spec.split(","):
        name, _, image = part.partition("=")
        apps.append((name, image or B.APP_IMAGE))
    return apps


def ensure_images(apps, rebuild):
    for img in dict.fromkeys(img for _, img in apps):
        if B.image_exists(img) and not (rebuild and img == B.APP_IMAGE):
            continue
        if img != B.APP_IMAGE:
            sys.exit(f"image {img} not found; build or pull it first")
        B.log(f"building {img} from the repo Dockerfile")
        subprocess.run(["docker", "build", "-t", img, B.ROOT], check=True)
    if os.environ.get("BENCH_PREPARE_ONLY") == "1":
        return
    if not B.image_exists(B.LOADGEN_IMAGE) or rebuild:
        if not os.path.exists(os.path.join(B.BENCH, "loadgen", "Dockerfile")):
            sys.exit(f"{B.LOADGEN_IMAGE} not found and bench/loadgen/Dockerfile does not exist yet")
        B.log(f"building {B.LOADGEN_IMAGE}")
        subprocess.run(["docker", "build", "-t", B.LOADGEN_IMAGE, os.path.join(B.BENCH, "loadgen")], check=True)
    if not B.image_exists(B.PG_IMAGE):
        subprocess.run(["docker", "pull", B.PG_IMAGE], check=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--apps", default="campfire")
    ap.add_argument("--reps", type=int, default=4)
    ap.add_argument("--out")
    ap.add_argument("--user-agent")
    ap.add_argument("--dry-run", action="store_true", help="check prerequisites and print the plan; run nothing")
    ap.add_argument("--prepare-only", action="store_true", help="start the containers, load the seed, log in and run the preflight; no suites")
    ap.add_argument("--rebuild", action="store_true", help="rebuild the harness, app and load generator images")
    a = ap.parse_args()
    if platform.system() == "Darwin" and not os.environ.get("BENCH_IN_HARNESS"):
        launch_in_harness(sys.argv[1:], a.rebuild)

    apps = parse_apps(a.apps)
    if a.prepare_only:
        os.environ["BENCH_PREPARE_ONLY"] = "1"
    B.USER_AGENT_ARGS.extend(["--user-agent", a.user_agent] if a.user_agent else [])
    out = os.path.abspath(a.out or os.path.join(B.BENCH, "results", time.strftime("%Y%m%d-%H%M%S")))
    problems = []
    if os.environ.get("BENCH_IN_HARNESS") and not (out + os.sep).startswith(B.ROOT + os.sep):
        problems.append(f"--out {out} is outside the repo, the only path shared with the harness container")
    if shutil.which("docker") is None or B.docker("info", check=False).returncode != 0:
        problems.append("docker is not reachable")
    if shutil.which("taskset") is None:
        problems.append("taskset not found (Linux, or the harness container, is required)")
    if not os.path.isdir("/sys/fs/cgroup/docker") and not os.path.isdir("/sys/fs/cgroup/system.slice"):
        problems.append("container cgroups not visible under /sys/fs/cgroup (run in the harness: --cgroupns host -v /sys/fs/cgroup:/sys/fs/cgroup)")
    for p in (B.PORT, B.PG_PORT):
        if not B.port_free(p):
            problems.append(f"port {p} is already in use")
    for f in ("campfire.sql", "labels.json"):
        if not os.path.exists(os.path.join(B.SEED, f)):
            problems.append(f"{os.path.join(B.SEED, f)} missing (the seed importer produces it)")
    unknown = [s for s in B.SUITES if s not in ("http", "liveview", "distinct", "upload")]
    if unknown:
        problems.append(f"unknown suites {unknown}")
    if a.dry_run:
        print(f"apps: {apps}\nreps: {a.reps}\nout: {out}\nsuites: {B.SUITES}\nserver cpus {B.SERVER_CPUS}, loadgen cpus {B.LOADGEN_CPUS}, harness cpus {B.PROCMEM_CPUS}")
        print(f"base: {B.BASE}  postgres: 127.0.0.1:{B.PG_PORT}  seed: {B.SEED}")
        if os.path.exists(os.path.join(B.SEED, "labels.json")):
            L = B.Labels(os.path.join(B.SEED, "labels.json"))
            import suites as S
            for name, kind, path in S.routes(L, "/assets/app-<digest>.css"):
                print(f"  {name:14} {kind:8} {path}")
            print(f"  skipped: {S.SKIPPED}")
        print("problems:" if problems else "no problems found", *problems, sep="\n  ")
        sys.exit(1 if problems else 0)
    if problems:
        sys.exit("cannot run:\n  " + "\n  ".join(problems))
    ensure_images(apps, a.rebuild)
    os.makedirs(out, exist_ok=True)
    B.log(write_env(os.path.join(out, "env.txt"), apps, a.reps, a.user_agent))
    labels = B.Labels(os.path.join(B.SEED, "labels.json"))
    for rep in range(1, a.reps + 1):
        order = apps if rep % 2 else list(reversed(apps))      # alternate the order between reps
        for name, image in order:
            with open(os.path.join(out, "uptime.log"), "a") as u:
                u.write(f"{time.strftime('%T')} {name} rep {rep} start: {sh_out('uptime')}\n")
            run_rep(name, image, rep, out, labels, a.user_agent)
            with open(os.path.join(out, "uptime.log"), "a") as u:
                u.write(f"{time.strftime('%T')} {name} rep {rep} end:   {sh_out('uptime')}\n")
    report = subprocess.run([sys.executable, os.path.join(B.BENCH, "report"), out], capture_output=True, text=True)
    open(os.path.join(out, "report.md"), "w").write(report.stdout)
    print(report.stdout)
    if report.returncode != 0:
        B.log("report failed:", report.stderr[-1500:])


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        B.cleanup()
        sys.exit(130)
